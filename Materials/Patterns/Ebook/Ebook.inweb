Pattern "Ebook" {
	based on: HTML
	format: ePub
	footnotes plugin: None
	mathematics plugin: None
	assets
		.js files: embed file and prefix {
			<script>
		} and suffix {
			</script>
		}
		.css files: embed file and transform names and prefix {
			<style type="text/css">
		} and suffix {
			</style>
		}
	end
}
