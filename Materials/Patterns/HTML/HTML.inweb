Pattern "HTML" {
	format: HTML
	default range: sections
	plugin: Base
	mathematics plugin: MathJax3
	footnotes plugin: Bigfoot
	search plugin: SeekLocateDisplay
	assets
		seek_locate_display.html file in SeekLocateDisplay: collate to search box
		sld_data.js file in SeekLocateDisplay: copy and add data and embed {
			<script src="URL"></script>
		}
		.html files: collate
		.js files: copy and embed {
			<script src="URL"></script>
		}
		.css files: copy and transform names and embed {
			<link href="URL" rel="stylesheet" rev="stylesheet" type="text/css">
		}
	end
}
