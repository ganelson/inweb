-cases [Blueprint] 'inweb/Tests/Test Cases'
-cases [BlueprintError] 'inweb/Tests/Test Errors'
-cases [Painter] 'inweb/Tests/Test Painter'
-cases [Omnium] 'inweb/Tests/Test Omnium'

-recipe [Blueprint]
	set: $INWEB = inweb/Tangled/inweb
	set: $INPRINT = intest/inprint/Tangled/inprint
	mkdir: $PATH/_Results_Actual
	mkdir: $PATH/_Results_Ideal
	set: $A = $PATH/_Results_Actual/$CASE.txt
	set: $I = $PATH/_Results_Ideal/$CASE.txt
	set: $ABP = $PATH/_Results_Actual/$CASE-BP.txt
	set: $IBP = $PATH/_Results_Ideal/$CASE-BP.txt
	
	set: $SANDBOX = $WORK/sandbox
	mkdir: $SANDBOX
	step: rm -rf $SANDBOX
	mkdir: $SANDBOX
	
	if: $CASE %c+-(%c+)
		set: $BLUEPRINT = $SUBEXPRESSION1.blueprint
	else
		set: $BLUEPRINT = EMPTY.blueprint
	endif
	
	set: $BP = $PATH/$CASE-BP.txt
	step: $INPRINT build -silent $BLUEPRINT -in $SANDBOX -archives $PATH/../Blueprints
	or: 'failed inprint'
	set: $RELA = ../../../../$A
	set: $RELINWEB = ../../../../$INWEB
	step: cd $SANDBOX ; $RELINWEB $[$PATH/$CASE.txt$] -fixtime -locale console=utf-8 >$RELA 2>&1
	or: 'failed inweb' $A
	show: $A
	match platform text: $A $I
	or: 'produced the wrong console output'
	step: $INPRINT draw $SANDBOX -to $ABP
	or: 'failed inprint'
	match platform text: $ABP $IBP
	or: 'produced the wrong file tree'

	pass: 'passed'

-end

-recipe [BlueprintError]
	set: $INWEB = inweb/Tangled/inweb
	set: $INPRINT = intest/inprint/Tangled/inprint
	mkdir: $PATH/_Results_Actual
	mkdir: $PATH/_Results_Ideal
	set: $A = $PATH/_Results_Actual/$CASE.txt
	set: $I = $PATH/_Results_Ideal/$CASE.txt
	set: $ABP = $PATH/_Results_Actual/$CASE-BP.txt
	set: $IBP = $PATH/_Results_Ideal/$CASE-BP.txt
	
	set: $SANDBOX = $WORK/sandbox
	mkdir: $SANDBOX
	step: rm -rf $SANDBOX
	mkdir: $SANDBOX
	
	if: $CASE %c+-(%c+)
		set: $BLUEPRINT = $SUBEXPRESSION1.blueprint
	else
		set: $BLUEPRINT = EMPTY.blueprint
	endif
	
	set: $BP = $PATH/$CASE-BP.txt
	step: $INPRINT build -silent $BLUEPRINT -in $SANDBOX -archives $PATH/../Blueprints
	or: 'failed inprint'
	set: $RELA = ../../../../$A
	set: $RELINWEB = ../../../../$INWEB
	fail step: cd $SANDBOX ; $RELINWEB $[$PATH/$CASE.txt$] -fixtime >$RELA 2>&1
	or: 'inweb did not return error' $A
	show: $A
	match platform text: $A $I
	or: 'produced the wrong console output'

	pass: 'passed'

-end

-recipe [Painter]
	set: $INWEB = inweb/Tangled/inweb
	set: $LANGUAGES = inweb/Dialects
	set: $INTERNAL = Internal

	set: $CANVAS = $PATH/$CASE.txt
	mkdir: $PATH/_Results_Actual
	mkdir: $PATH/_Results_Ideal
	mkdir: $PATH/_Results_Console
	set: $A = $PATH/_Results_Actual/$CASE.txt
	set: $I = $PATH/_Results_Ideal/$CASE.txt
	step: $INWEB test-language $LANGUAGES/$CASE.inweb -locale console=utf-8 -on $CANVAS -fixtime >$A 2>&1
	or: 'failed inweb' $A
	show: $A
	match text: $A $I
	or: 'produced the wrong painting'

	pass: 'passed'

-end

-recipe [Omnium]
	set: $INWEB = inweb/Tangled/inweb
	set: $OMNIUM = inweb/Tests/omnium
	set: $OMNIUMA = $WORK/Woven
	mkdir: $OMNIUMA
	mkdir: $OMNIUMA/docs-assets
	set: $OMNIUMI = inweb/Tests/omnium/_Ideal
	set: $CONSOLE = $WORK/console.txt
	set: $LANGUAGES = inweb/Dialects
	set: $INTERNAL = Internal

	set: $CANVAS = $PATH/$CASE.txt
	if: $CASE %c+-plain
		step: $INWEB weave $OMNIUM -as plain -only 0 -to $OMNIUMA -fixtime -locale console=utf-8 >$CONSOLE 2>&1
		or: 'failed inweb' $CONSOLE
		match text: $OMNIUMA/Complete.txt $OMNIUMI/Complete.txt
	endif
	if: $CASE %c+-pdftex
		step: $INWEB weave $OMNIUM -as pdftex -no-commands -only 0 -to $OMNIUMA -fixtime -locale console=utf-8 >$CONSOLE 2>&1
		or: 'failed inweb' $CONSOLE
		match text: $OMNIUMA/Complete.tex $OMNIUMI/Complete.tex
	endif
	if: $CASE %c+-pdflatex
		step: $INWEB weave $OMNIUM -as pdflatex -no-commands -only 0 -to $OMNIUMA -fixtime -locale console=utf-8 >$CONSOLE 2>&1
		or: 'failed inweb' $CONSOLE
		match text: $OMNIUMA/Complete.latex $OMNIUMI/Complete.latex
	endif
	if: $CASE %c+-xelatex
		step: $INWEB weave $OMNIUM -as xelatex -no-commands -only 0 -to $OMNIUMA -fixtime -locale console=utf-8 >$CONSOLE 2>&1
		or: 'failed inweb' $CONSOLE
		match text: $OMNIUMA/Complete.xelatex $OMNIUMI/Complete.xelatex
	endif
	if: $CASE %c+-debug
		step: $INWEB weave $OMNIUM -as TestingInweb -no-commands -only 0 -to $OMNIUMA -fixtime -locale console=utf-8 >$CONSOLE 2>&1
		or: 'failed inweb' $CONSOLE
		match text: $OMNIUMA/Complete.debug.txt $OMNIUMI/Complete.debug.txt
	endif
	if: $CASE %c+-html
		step: $INWEB weave $OMNIUM -no-commands -to $OMNIUMA -fixtime -locale console=utf-8 >$CONSOLE 2>&1
		or: 'failed inweb' $CONSOLE
		match text: $OMNIUMA/index.html $OMNIUMI/index.html
		or: 'failed to match index file'
		match text: $OMNIUMA/1-ld.html $OMNIUMI/1-ld.html
		or: 'failed to match section 1 file'
		match text: $OMNIUMA/2-md.html $OMNIUMI/2-md.html
		or: 'failed to match section 2 file'
	endif
	pass: 'passed'
-end

-recipe [NoLongerUsed]
	set: $INWEB = inweb/Tangled/inweb
	set: $LANGUAGES = inweb/Dialects
	set: $INTERNAL = Internal

	mkdir: $PATH/_Results_Actual
	mkdir: $PATH/_Results_Ideal
	mkdir: $PATH/_Results_Console
	set: $A = $PATH/_Results_Actual/$CASE.txt
	set: $I = $PATH/_Results_Ideal/$CASE.txt
	set: $C = $PATH/_Results_Console/$CASE.txt
	step: $INWEB weave $PATH/variations -only $CASE -as TestingInweb -to $A -fixtime >$C 2>&1
	or: 'failed inweb' $C
	show: console $C
	show: $A
	match text: $A $I
	or: 'produced the wrong weave tree'

	pass: 'passed'

-end

-recipe [NoLongerUsedEither]
	set: $INWEB = inweb/Tangled/inweb
	set: $INTERNAL = Internal

	set: $WEB = $PATH/$CASE.inweb

	mkdir: $PATH/_Scan_Actual
	mkdir: $PATH/_Scan_Ideal
	set: $SA = $PATH/_Scan_Actual/$CASE.txt
	set: $SI = $PATH/_Scan_Ideal/$CASE.txt
	step: $INWEB inspect -scan $WEB -locale console=utf-8 >$SA 2>&1
	or: 'failed inweb trying to scan' $SA
	show: $SA
	match text: $SA $SI
	or: 'produced the wrong scan'

	mkdir: $PATH/_Tangled_Actual
	mkdir: $PATH/_Tangled_Ideal
	mkdir: $PATH/_Tangled_Console
	set: $TA = $PATH/_Tangled_Actual/$CASE.txt
	set: $TI = $PATH/_Tangled_Ideal/$CASE.txt
	set: $TC = $PATH/_Tangled_Console/$CASE.txt
	step: $INWEB tangle $WEB -no-ctags -to $TA -fixtime >$TC 2>&1
	or: 'failed inweb trying to tangle' $TC
	show: $TA
	match text: $TA $TI
	or: 'produced the wrong tangled code'

	pass: 'passed'

-end


