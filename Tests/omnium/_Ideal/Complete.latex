    \catcode`@=11
    \def\strikethrough#1{\leavevmode\strikethr@ugh#1 \relax}
    \def\strikethr@ugh#1 {\strike@word{#1}\futurelet\next\strike@next}
    \def\strike@next{\ifx\next\relax\else\strike@space\expandafter\strikethr@ugh\fi}
    \def\strike@word#1{\setbox0=\hbox{#1}\rlap{\strike@rule width\wd0}\box0}
    \def\strike@space{\leaders\strike@rule\sp@ce}
    \def\strike@rule{\vrule height2.4pt depth-2pt}
    \def\sp@ce{\hskip\fontdimen2\font plus\fontdimen3\font minus\fontdimen4\font}
    \catcode`@=12
    %
    % `type.tex`
    %
    % This file shows the relative stylings and point sizes of different typographic
    % features used by Inweb, but does not set the font family: for that, see `page.tex`.
    %
    % Used for holon names (and other paragraph cross-references)
    \def\holonnametext#1{\textsf{\small #1}}
    \def\holonnumbertext#1{\textsf{\footnotesize #1}}
    %
    % Sans-serif footnote-sized text is used for endnotes and also the table of contents
    \def\sectiontoctext#1{\textsf{\footnotesize #1}}
    \def\endnotetext#1{\textsf{\footnotesize #1}}
    %
    % Headings for chapters and sections
    \def\chaptertitletext#1{\textsf{\Huge #1}}
    \def\sectiontitletext#1{\textsf{\huge #1}}
    %
    % Enumerations are marked "enum" in this font; default definitions are
    % subscripted "def" in this font
    \def\defnannotationtext#1{\textit{\footnotesize #1}}
    %
    % Type size and leading for body text and for code samples
    \def\bodytextspacing{\normalsize
      \setbox\strutbox=\hbox{\vrule height8.5pt depth3.5pt width 0pt}%
      \normalbaselines\rm}
    %
    \def\codetextspacing{\small
      \setbox\strutbox=\hbox{\vrule height6pt depth3pt width 0pt}%
      \normalbaselines\tt}
    %

    % `verbatim-macros.tex`
    %
    % These are macros to make code extracts work, which is much trickier than it
    % looks. There are LaTeX packages for this, but often those have tricky
    % restrictions (can't be used in `\centerline`, `\footnote`, etc.). So we'll
    % write our own macros, and cope with their issues by compiling around those
    % issues (see the Inweb source code). In the end, this is code going back to
    % Knuth's handling of verbatim code in the TeXBook, though slightly tweaked.
    %
    \newskip\ttglue
    %
    \chardef\other=12
    \def\codetext{\begingroup\codetextspacing\frenchspacing
      \catcode`\\=\other
      \catcode`\{=\other
      \catcode`\}=\other
      \catcode`\$=\other
      \catcode`\&=\other
      \catcode`\#=\other
      \catcode`\%=\other
      \catcode`\~=\other
      \catcode`\_=\other
      \catcode`\^=\other
      \obeyspaces \obeylines \tt}
    %
    \def\|{\leavevmode\hbox{\tt\char`\|}} % vertical line
    \outer\def\begintt{$$\let\par=\endgraf \codetext \parskip=0pt
      \catcode`\|=0 \rightskip-5pc \ttfinish}
    {\catcode`\|=0 |catcode`|\=\other % | is temporary escape character
      |obeylines % end of line is active
      |gdef|ttfinish#1^^M#2\endtt{#1|vbox{#2}|endgroup|bodytext$$}}
    \catcode`\|=\active
    %
    {\obeylines \gdef|{\codetext \spaceskip\ttglue \let^^M=\  \let|=\endgroup}}
    %
    \catcode`@=11
    \def\beginlines{\par\begingroup\nobreak\medskip\parindent=0pt \obeylines\nobreak \everypar{\strut}}
    \def\beginlinestighter{\par\begingroup\nobreak\parindent=0pt \kern1pt\nobreak \obeylines \everypar{\strut}}
    \def\endlines{\kern1pt\endgroup\medbreak\noindent}
    \catcode`@=12
